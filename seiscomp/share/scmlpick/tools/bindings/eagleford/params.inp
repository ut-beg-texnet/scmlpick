# IP: currently uses only one address; if more than one, it'll be ignored (fix)
ip = http://scarchive.beg.utexas.edu:8880/
#ip = https://service.iris.edu/

# Start time and end time for analysis (ignored if --scheduler X given)
starttime = 2024-01-01 00:00:00
endtime = 2024-01-02 00:00:00
# Size, in minutes, of each waveform chunk (ignored if --scheduler X given)
dt = 30
# Overlap, in minutes, of each waveform chunk
overlap = 2
# Area of interest BNA
aoi_bna = eagleford.bna

# Locator and velocity model to be used
locator = scanlocefd
locator_profile = iasp91

# SeisComP
seiscomp_root = /opt/seiscomp
sc_database = mysql://userro:Itr0nly@scarchive.beg.utexas.edu/seiscomp
#inventory_db = mysql://fbtestrw:FullRw2112@begws142.beg.utexas.edu/fbtest
#config_db = mysql://fbtestrw:FullRw2112@begws142.beg.utexas.edu/fbtest
#record_stream = fdsnws://service.iris.edu
#routing_table = Amplitude:EQAMPLITUDE,Pick:EQPICK,Origin:EQLOCATION,Magnitude:EQMAGNITUDE,StationMagnitude:EQMAGNITUDE
host = scdb.beg.utexas.edu
user = eqcctef
report = True
author = EQCCT-EFD

# Method to get data (specific, radius, polygon)
download_method = radius
# Download specific streams (ObsPy FDSNWS syntax/wildcards) 
download_data = TX.EF02.*.*
#download_data = TX.MB06.00.HH*
# Download within radius from a point.
download_radius = 3.0
download_lat = 28.95
download_lon = -97.98
# Download within polygon.
download_minlat = 30.37
download_maxlat = 30.6
download_minlon = -103.78
download_maxlon = -103.46
# Drop stations/networks from the analysis
sta2ignore = GL.PEC4
net2ignore = XX, TEST
# Add stations that are not within radius or polygon (NET.STA)
sta2add = 
# Add streams that are not within radius or polygon (ObsPy FDSNWS syntax/wildcards)
st2add =

# EQCCT
eqcct_Pmodel = /texnet/victor/longterm/loctool/models/EagleFord/test_trainer_001.h5
eqcct_Smodel = /texnet/victor/longterm/loctool/models/EagleFord/test_trainer_S_007.h5
#eqcct_Pmodel = /texnet/victor/longterm/loctool/models/ModelPS/test_trainer_024.h5
#eqcct_Smodel = /texnet/victor/longterm/loctool/models/ModelPS/test_trainer_021.h5
eqcct_overlap = 0.3
eqcct_P_threshold = 0.1
eqcct_S_threshold = 0.1
eqcct_batch_size = 500
eqcct_gpu_id = 0
eqcct_gpu_limit = 12
# eqcct_stations_filters = stations_filters_quantiles.inp
# gpuid -1 disables gpu (cpu only) / gpu memory limit in GB
# future: set P/S threshold based on station (dict)
