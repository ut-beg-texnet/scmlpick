    def init(self):
        if not StreamApplication.init(self): return False
        # self.enableTimer(self.latencyPeriod)
        relevant_files = set()
        relevant_stations = set()

        if self.commandline().hasOption("playback"):
            self.playback = True
            if self.commandline().hasOption("profile"):
                self.playProfile = self.commandline().optionString("profile")
            else:
                logging.error("Need to declare profile parameter")
            if self.commandline().hasOption("mseed-files"):
                self.mseed = True
                self.waveformPath = self.commandline().optionString("mseed-files")
            else:
                logging.debug("Running playback mode with mseed files, mseed files path is missing")
            if self.commandline().hasOption("output-file"):
                self._outputFile = self.commandline().optionString("output-file")
            else:
                logging.debug("Output file is missing.")
            if self.commandline().hasOption("start"):
                start_time = self.commandline().optionString("start")
                # start_time = UTCDateTime(start_time)
                start_time = self.parse_time(start_time)
            if self.commandline().hasOption("end"):
                end_time = self.commandline().optionString("end")
                # end_time = UTCDateTime(end_time)
                end_time = self.parse_time(end_time)

        if self.commandline().hasOption("cpu-number"):
            self.numCPUs = self.commandline().optionInt("cpu-number")
        if self.commandline().hasOption("max-tasks"):
            self.maxTasksQueue = self.commandline().optionInt("max-tasks")


        #Bindings
        self._load_bindings_from_db()
        # print(self.bindings)
        # self.all_station_codes = self.stations
        for b in self.bindings:
            check_pick = any(
                k.startswith("profiles.")
                and k.endswith(".pickEnable")
                and (not self.playback or k.split(".")[1] == self.playProfile)
                and (
                    (isinstance(v, bool) and v) or
                    str(v).strip().lower() in ("true", "1", "yes")
                )
                for k, v in b.items()
            )
            if check_pick and b.get("net") and b.get("sta"):
                self.all_station_codes.append(f"{b['net']}.{b['sta']}")
        if not self.all_station_codes:
             logging.error("Bindings missing")
             sys.exit(1)
        times_list = []
        availability = {}
        if not self.playback and not self.mseed:
            self.updateStreams()
            self.now = UTCDateTime(str(Time.GMT()))
            self.startTime = UTCDateTime(pd.to_datetime(str(self.now)) + timedelta(seconds=self.startLatency))

            # self.global_staSend_count = Value("i", 0)
            # self.global_delayStaSend_count = Value("i", 0)
            # self.global_staSet_count = Value("i", 0)

            self.global_staSend_counts = mp.Array('i', [0]*self.numWorkers)
            # self.global_delayStaSend_counts = mp.Array('i', [0]*self.numWorkers)
            self.global_staSet_counts = mp.Array('i', [0]*self.numWorkers)
            self.stream_lock = threading.Lock()
            self._minute_flight = threading.Lock()
            self._hold_until = 0.0

            self.worker_station_groups = self.divide_stations(self.all_station_codes, self.numWorkers)
            self.worker_queues = []
            self.worker_control_queues = []
            self.worker_processes = []
            self.init_worker_processes()

            logging.info("Starting time %s " % self.now)
            logging.info("Starting time plus start latency %s " % self.startTime)
        else:
            relevant_files, relevant_stations, availability = self.get_relevant_stations(self.waveformPath,self.all_station_codes,start_time,end_time)
            times_list = self.chunk_time(start_time, end_time, self.windowLength, self.timeShift)


        # Start a thread to monitor the results without blocking the main process
        #self.monitorThread = threading.Thread(target=self.monitorTasks, args=(self.tasks_ids,))
        self.monitorThread = threading.Thread(target=self.monitorTasks)
        self.monitorThread.start()

        # Allocates X amount of CPUs for the function of creating tasks
        # ray.init(ignore_reinit_error=True, num_cpus=self.numCPUs, logging_level=stdlogging.FATAL, log_to_driver=False, runtime_env={"working_dir": predictorPath})
        # ray.init(ignore_reinit_error=True, num_cpus=self.numCPUs, logging_level=stdlogging.FATAL, log_to_driver=True, runtime_env={"env_vars": {"RAY_DEDUP_LOGS": "0"}})
        ray.init(ignore_reinit_error=True, num_cpus=self.numCPUs, logging_level=stdlogging.FATAL, log_to_driver=False)
        logging.info(
            "Ray CPU pool is %s (ray.numCPUs). Station groups are %s (ray.numWorkers). "
            "Those are different knobs: numWorkers only splits the station list."
            % (self.numCPUs, self.numWorkers)
        )

        self.df_filters = self.get_filters()

        self.params = {
            "filterShift" : self.filterShift,
            "share_path" : self.ei.shareDir(),
            "P_threshold": self.eqcctPthr,
            "S_threshold": self.eqcctSthr,
            "detection_threshold": self.detectionThr,
            "normalization_mode": "std",
            "overlap": self.timeShift,
            "batch_size": self.eqcctBatchSize,
            "overwrite": True,
            # "model": model,
            "p_model": self.eqcct_Pmodel,
            "s_model": self.eqcct_Smodel,
            "architecture": self.architecture,
            "numCPUs": self.numCPUs,
            "gpu_id": self.gpuID,
            "gpu_limit": self.gpuLimit,
            "df_filters": self.df_filters,
            "playback": self.playback,
            "mseed": self.mseed,
            "windowLength": self.windowLength,
            "stations": relevant_stations,
            "files": relevant_files,
            "maxTasksQueue": self.maxTasksQueue,
            "time_list": times_list,
            "availability": availability,
            "execution": self.execution,
            "precision": self.precision,
            "maxCalls": self.maxCalls,
            }

        self.model_actors = []
        if self.execution == "modelactor":
            from predictor.model_actor import create_picker_actors
            logging.info(
                "Model-actor execution, precision %s, architecture %s. "
                "Starting %s actors; each loads the picker once."
                % (self.precision, self.architecture, self.numCPUs)
            )
            self.model_actors = create_picker_actors(
                self.numCPUs,
                self.architecture,
                self.eqcct_Pmodel,
                self.eqcct_Smodel,
                self.precision,
            )
            self.params["model_actors"] = self.model_actors
        else:
            # max_calls cannot be passed through .options() on this Ray.
            # The remote function is built here so ray.maxCalls is the limit.
            self.params["picker_remote"] = ray.remote(
                max_calls=int(self.maxCalls), max_retries=1
            )(scmlpick.picker)
            logging.info(
                "Task execution, precision %s, architecture %s. "
                "Each station loads the picker. A worker process exits after %s "
                "stations (ray.maxCalls) and Ray starts a new one, so the RAM "
                "of that process returns to the system."
                % (self.precision, self.architecture, self.maxCalls)
            )

        if self.standard:
            logging.info("Standard pick delivery strategy active %s" % self.standard)
        else:
            logging.info("Standard pick delivery strategy not active %s" % self.standard)


        if self.simulation:
            logging.info("Simulation pick delivery strategy active %s" % self.simulation)
            self._pacer_init(
                max_sleep=10,
                max_global_delay=20.0,
                recover_threshold=5.0,
                catchup_factor=0.5,
                grace=0.01
            )
        else:
            logging.info("Simulation pick delivery strategy not active %s" % self.simulation)

        if self.bulk:
            logging.info("Bulk pick delivery strategy active %s with %s s of interval" % (self.bulk,self.bulkInterval))
            self.start_bulk_sender(interval_s=self.bulkInterval)
        else:
            logging.info("Bulk pick delivery strategy not active %s" % self.bulk)

        return True

    def _pacer_init(self,
                    max_sleep=None,
                    max_global_delay=None,
                    recover_threshold=1.0,
                    catchup_factor=0.5,
                    grace=0.02):

        self._pacer_max_sleep = max_sleep
        self._pacer_max_global_delay = max_global_delay
        self._pacer_recover_threshold = recover_threshold
        self._pacer_catchup_factor = float(catchup_factor)
        self._pacer_grace = float(grace)

        self._pacer_q = PriorityQueue()
        self._pacer_seq = count()
        self._pacer_stop_evt = threading.Event()
        self._pacer_thread = threading.Thread(target=self._pacer_run, daemon=True)

        self._pacer_has_base = False
        self._pacer_base_pick_time = 0.0
        self._pacer_base_mono_time = 0.0

        self._pacer_last_sent_ts = None 
        self._pacer_initial_delay = None
        self._pacer_seen_ids = set()

        self._pacer_thread.start()

    def safe_trim_edge_pad(self, tr, starttime, endtime, nearest_sample=False):
        tr_cut = tr.copy()

        tr_cut.trim(
            starttime=starttime,
            endtime=endtime,
            pad=False,
            nearest_sample=nearest_sample
        )

        if tr_cut.stats.npts == 0:
            return None

        delta = tr_cut.stats.delta
        expected_npts = int(round((endtime - starttime) / delta)) + 1

        pad_left = int(round((tr_cut.stats.starttime - starttime) / delta))
        pad_left = max(0, pad_left)

        pad_right = expected_npts - tr_cut.stats.npts - pad_left
        pad_right = max(0, pad_right)

        data = np.asarray(tr_cut.data)

        if pad_left > 0 or pad_right > 0:
            data = np.pad(data, (pad_left, pad_right), mode="edge")

        tr_cut.data = data[:expected_npts]
        tr_cut.stats.starttime = starttime

        return tr_cut

    def _exact_fit_append(self, existing, new_tr, buffers):
        """Append new_tr when merge(method=1, fill_value='interpolate') would only concatenate.

        ObsPy treats that case as delta == 0: same id, sampling rate, calib and dtype,
        and the next sample starts one sample after the current end. The new Trace
        views a spare buffer, so the history is copied only when that buffer grows.
        The previous Trace object is left unchanged (streamPick may still hold it).
        Returns None for gaps, overlaps or a mismatched header; the caller uses merge.
        """
        if existing.id != new_tr.id:
            return None
        if existing.stats.sampling_rate != new_tr.stats.sampling_rate:
            return None
        if existing.stats.calib != new_tr.stats.calib:
            return None
        if existing.data.dtype != new_tr.data.dtype:
            return None
        if isinstance(existing.data, np.ma.MaskedArray) or isinstance(new_tr.data, np.ma.MaskedArray):
            return None
        if existing.stats.starttime > new_tr.stats.starttime:
            return None
        sr = existing.stats.sampling_rate
        if not sr:
            return None
        n_old = len(existing.data)
        n_new = len(new_tr.data)
        if n_old == 0 or n_new == 0 or existing.stats.npts != n_old:
            return None
        delta = (new_tr.stats.starttime - existing.stats.endtime) * sr
        delta = int(compatibility.round_away(delta)) - 1
        if delta != 0:
            return None
        n = n_old + n_new
        buf = buffers.get(existing.id)
        base = existing.data.base
        reusable = (
            buf is not None
            and base is buf
            and buf.dtype == existing.data.dtype
            and buf.shape[0] >= n
        )
        if not reusable:
            cap = max(n, n + int(sr * 60))
            buf = np.empty(cap, dtype=existing.data.dtype)
            buf[:n_old] = existing.data
            buffers[existing.id] = buf
        buf[n_old:n] = new_tr.data
        out = Trace(data=buf[:n], header={
            'network': existing.stats.network,
            'station': existing.stats.station,
            'location': existing.stats.location,
            'channel': existing.stats.channel,
            'sampling_rate': existing.stats.sampling_rate,
            'starttime': existing.stats.starttime,
            'calib': existing.stats.calib,
        })
        if out.data.base is not buf or len(out.data) != n or out.stats.npts != n:
            buffers.pop(existing.id, None)
            return None
        return out

    @staticmethod
    def _stream_from_packets(meta, blob):
        st = Stream()
        if blob is None:
            for net, sta, loc, chan, sr, start, data in meta:
                st.append(Trace(data=data, header={
                    'network': net,
                    'station': sta,
                    'location': loc,
                    'channel': chan,
                    'sampling_rate': sr,
                    'starttime': UTCDateTime(start),
                }))
            return st
        offset = 0
        for net, sta, loc, chan, sr, start, npts in meta:
            data = np.array(blob[offset:offset + npts], dtype=np.float64, copy=True)
            offset += npts
            st.append(Trace(data=data, header={
                'network': net,
                'station': sta,
                'location': loc,
                'channel': chan,
                'sampling_rate': sr,
                'starttime': UTCDateTime(start),
            }))
        return st

    def _slice_bounds(self, trace, starttime, endtime):
        """Sample range of Trace.slice(nearest_sample=True).

        i1 is exclusive. The returned time is the time of sample i0, which is
        what ObsPy stores as the sliced trace's starttime.
        """
        npts = int(trace.stats.npts)
        sr = float(trace.stats.sampling_rate)
        t0 = trace.stats.starttime
        if npts <= 0 or not sr:
            return 0, 0, t0
        if starttime is None or starttime <= t0:
            i0 = 0
        elif starttime > trace.stats.endtime:
            return npts, npts, t0 + npts * trace.stats.delta
        else:
            i0 = int(compatibility.round_away((starttime - t0) * sr))
            if i0 < 0:
                i0 = 0
            elif i0 >= npts:
                return npts, npts, t0 + npts * trace.stats.delta
        kept_start = t0 + i0 * trace.stats.delta
        n_after = npts - i0
        if endtime is None:
            return i0, npts, kept_start
        delta = int(compatibility.round_away((endtime - kept_start) * sr) - n_after + 1)
        if delta >= 0:
            return i0, npts, kept_start
        if endtime < kept_start:
            return i0, i0, kept_start
        total = n_after + delta
        if endtime == kept_start:
            total = 1
        if total < 0:
            total = 0
        elif total > n_after:
            total = n_after
        return i0, i0 + total, kept_start

    def _owned_samples(self, trace, starttime, endtime, dtype=None):
        """Copy the sliced samples so later edits cannot change them.

        Masked gaps are filled with zeros before the copy.
        """
        i0, i1, kept_start = self._slice_bounds(trace, starttime, endtime)
        raw = trace.data
        if np.ma.isMaskedArray(raw):
            raw = np.ma.filled(raw, 0.0)
        if i1 <= i0:
            out_dtype = raw.dtype if dtype is None else dtype
            return np.zeros(0, dtype=out_dtype), kept_start
        piece = raw[i0:i1]
        if dtype is None:
            data = np.array(piece, copy=True)
        else:
            data = np.array(piece, dtype=dtype, copy=True)
        return data, kept_start

    def _trace_from_samples(self, trace, data, starttime):
        if len(data) == 0:
            return None
        return Trace(data=data, header={
            'network': trace.stats.network,
            'station': trace.stats.station,
            'location': trace.stats.location,
            'channel': trace.stats.channel,
            'sampling_rate': trace.stats.sampling_rate,
            'starttime': starttime,
            'calib': trace.stats.calib,
        })

    def _rebuild_stream_index(self, stream, stream_index):
        stream_index.clear()
        for i, trc in enumerate(stream):
            key = (trc.stats.network, trc.stats.station, trc.stats.channel)
            if key not in stream_index:
                stream_index[key] = i

    def _rebuild_pick_index(self, stream_pick, pick_index):
        pick_index.clear()
        for i, trc in enumerate(stream_pick):
            if trc.id not in pick_index:
                pick_index[trc.id] = i

    def _pacer_pick_id(self, p):
        try:
            pickObj = Pick.Cast(p)
            key = (
                pickObj.waveformID().networkCode(),
                pickObj.waveformID().stationCode(),
                pickObj.waveformID().locationCode(),
                pickObj.waveformID().channelCode(),
                pickObj.phaseHint().code(),
                round(self._pacer_pick_epoch(p), 6),
            )
            return f"K:{key}"
        except Exception:
            return f"OBJ:{id(p)}"

    def _pacer_pick_epoch(self, p):
        t = p.time()
        # try:
        v = t.value()
        sec = getattr(v, "seconds", lambda: None)()
        usec = getattr(v, "microseconds", lambda: 0)()
        if sec is not None:
            return float(sec) + float(usec) / 1e6
        else:
            logging.error(f"Failed converting pick.time() to epoch (pick={p})")

    def _pacer_submit(self, picks):
        if not picks:
            return
        items = []
        for p in picks:
            pid = self._pacer_pick_id(p)
            if pid in self._pacer_seen_ids:
                continue
            ts = self._pacer_pick_epoch(p)
            items.append((ts, pid, p))
        if not items:
            return
        items.sort(key=lambda x: x[0])

        if not self._pacer_has_base:
            self._pacer_base_pick_time = items[0][0]
            self._pacer_base_mono_time = time.monotonic()
            self._pacer_has_base = True
            logging.info(f"[pacer] base set: base_ts={self._pacer_base_pick_time:.6f}, base_mono={self._pacer_base_mono_time:.3f}")

        for ts, pid, p in items:
            self._pacer_seen_ids.add(pid)
            self._pacer_q.put((ts, next(self._pacer_seq), pid, p))

        now_wall = time.time()
        batch_sz  = len(items)
        batch_min_ts = items[0][0]
        batch_max_ts = items[-1][0]
        batch_min_age = max(0.0, now_wall - batch_max_ts)
        batch_max_age = max(0.0, now_wall - batch_min_ts)
        qsize = self._pacer_q.qsize()

        logging.info(f"[pacer] submit: batch={batch_sz} qsize={qsize} batch_min_age={batch_min_age:.3f}s batch_max_age={batch_max_age:.3f}s")

    def _pacer_stop(self, timeout=None):
        if getattr(self, "_pacer_thread", None) is None:
            return
        self._pacer_stop_evt.set()
        self._pacer_q.put((float("inf"), next(self._pacer_seq), None, None))
        self._pacer_thread.join(timeout=timeout)

    def _pacer_compute_ideal_target(self, ts):
        return self._pacer_base_mono_time + (ts - self._pacer_base_pick_time)

    def _pacer_apply_recovery(self, ideal_target, now, current_global_delay):
        target = ideal_target
        if self._pacer_max_global_delay is not None:
            lag_to_ideal = now - ideal_target
            if lag_to_ideal > self._pacer_max_global_delay:
                shift = lag_to_ideal - self._pacer_max_global_delay
                self._pacer_base_mono_time += shift
                target += shift
                logging.warning(f"[pacer] rebasing base by +{shift:.3f}s to cap global delay at {self._pacer_max_global_delay:.3f}s")

        if target < now:
            if now - target <= self._pacer_grace:
                target = now + (self._pacer_grace - (now - target))
            else:
                target = now

        if (self._pacer_initial_delay is not None and
            current_global_delay > self._pacer_initial_delay + self._pacer_recover_threshold):
            sleep = target - now
            if sleep > 0 and 0 < self._pacer_catchup_factor < 1.0:
                comp = sleep * (1.0 - self._pacer_catchup_factor)
                target = target - comp
                if target < now:
                    target = now
                logging.debug(
                    f"[pacer] catch-up: reducing sleep from {sleep:.3f}s to {(target-now):.3f}s "
                    f"(factor={self._pacer_catchup_factor:.2f})"
                )

        if self._pacer_max_sleep is not None:
            max_target = now + self._pacer_max_sleep
            if target > max_target:
                target = max_target

        return target

    def _pacer_run(self):
        while not self._pacer_stop_evt.is_set():
            try:
                ts, _seq, pid, p = self._pacer_q.get(timeout=0.5)
            except Empty:
                continue
            if p is None:
                break

            now = time.monotonic()
            ideal_target = self._pacer_compute_ideal_target(ts)

            global_delay_now = max(0.0, now - ideal_target)

            if self._pacer_initial_delay is None:
                self._pacer_initial_delay = global_delay_now
                logging.info(f"[pacer] initial_delay set to {self._pacer_initial_delay:.3f}s")

            target = self._pacer_apply_recovery(ideal_target, now, global_delay_now)

            sleep = target - time.monotonic()
            if sleep > 0:
                time.sleep(sleep)

            try:
                logging.info(f"[pacer] trying to send pick {p}, time target: {target}")
                self.sendPick(p, 'simul')
            except Exception as e:
                logging.error(f"[pacer] error sending pick: {e}")

            now_wall = time.time()
            real_delay = max(0.0, now_wall - ts)
            logging.info(f"[pacer] sent: pid={pid} real_delay={real_delay:.3f}s ts={ts:.3f} now={now_wall:.3f}")

            self._pacer_last_sent_ts = ts

            now2 = time.monotonic()
            last_target = self._pacer_compute_ideal_target(ts)
            current_delay = max(0.0, now2 - last_target)
            delta_vs_initial = current_delay - (self._pacer_initial_delay or 0.0)

            logging.info(
                f"[pacer] sent pick pid={pid} ts={ts:.3f} "
                f"delay_current={current_delay:.3f}s delta_vs_initial={delta_vs_initial:+.3f}s"
            )

    def parse_time(self, time_str: str) -> UTCDateTime:
        formats = ["%Y-%m-%d %H:%M:%S", "%Y-%m-%d"]
        
        for fmt in formats:
            try:
                dt = datetime.strptime(time_str, fmt)
                if fmt == "%Y-%m-%d":
                    dt = datetime(dt.year, dt.month, dt.day, 0, 0, 0)
                return UTCDateTime(dt)
            except ValueError:
                continue
        
        # None of the accepted formats matched.
        logging.error(f"Invalid start time format: '{time_str}'. "
                    f"Expected 'YYYY-MM-DD HH:MM:SS' or 'YYYY-MM-DD'.")
        self.handleClose()

    def start_bulk_sender(self, interval_s=1800):
        self._bulk_interval = interval_s
        self._bulk_buffer = []
        self._bulk_lock = threading.Lock()
        self._bulk_stop_evt = threading.Event()
        self._bulk_thread = threading.Thread(target=self._bulk_loop, daemon=True)
        self._bulk_thread.start()
        logging.info(f"[bulk] started with interval={interval_s}s")

    def stop_bulk_sender(self):
        if getattr(self, "_bulk_stop_evt", None):
            self._bulk_stop_evt.set()
        if getattr(self, "_bulk_thread", None):
            self._bulk_thread.join(timeout=5)
        logging.info("[bulk] stopped")

    def add_pick_to_bulk(self, p):
        if not hasattr(self, "_bulk_buffer"):
            self._bulk_buffer = []
        with self._bulk_lock:
            self._bulk_buffer.append(p)

    def _bulk_loop(self):
        while not self._bulk_stop_evt.is_set():
            start = time.monotonic()
            time.sleep(self._bulk_interval)

            with self._bulk_lock:
                if not self._bulk_buffer:
                    continue
                picks_to_send = self._bulk_buffer
                self._bulk_buffer = []

            count = len(picks_to_send)
            t0 = time.time()
            try:
                for p in picks_to_send:
                    self.sendPick(p, 'bulk')
            except Exception as e:
                logging.warning(f"[bulk] error sending picks: {e}")

            dt = time.time() - t0
            logging.info(f"[bulk] sent {count} picks in {dt:.3f}s at {t0:.3f}")

            elapsed = time.monotonic() - start
            if elapsed < self._bulk_interval:
                time.sleep(self._bulk_interval - elapsed)

    def get_mseed_files(self, input_path: str) -> list[str]:
        p = Path(input_path).expanduser()
        if any(ch in input_path for ch in ["*", "?", "["]):
            files = sorted(glob.glob(input_path))
            if not files:
                print(f"[ERROR] No .mseed files match pattern: {input_path}")
                # raise RuntimeError("Empty stream: no traces loaded.")
            return files
        if p.is_dir():
            files = sorted(str(x) for x in p.glob("*.mseed"))
            if not files:
                print(f"[ERROR] No .mseed files found in directory: {p}")
                # raise RuntimeError("Empty stream: no traces loaded.")
            return files
        if p.is_file():
            if p.suffix.lower() == ".mseed":
                return [str(p)]
            print(f"[ERROR] Path exists but is not a .mseed file: {p}")
            # raise RuntimeError("Empty stream: no traces loaded.")
        if p.suffix.lower() == ".mseed" and not p.is_absolute():
            candidate = Path.cwd() / p.name
            if candidate.exists():
                return [str(candidate)]
            print(f"[ERROR] File not found in current directory: {candidate}")
            # raise RuntimeError("Empty stream: no traces loaded.")
        print(f"[ERROR] Path not found: {p}")
        # raise RuntimeError("Empty stream: no traces loaded.")


    def get_relevant_stations(self, waveform_path, stations_all, start, end):
        requested_stations = set(stations_all)

        files_list = self.get_mseed_files(waveform_path)
        relevant_files = set()
        relevant_stations = set()
        per_station_intervals = defaultdict(list)

        for fn in files_list:
            try:
                head = read(fn, headonly=True)
            except Exception as e:
                print(f"[HEAD-ONLY ERROR] {fn}: {e!r}")
                continue

            for tr in head:
                net = tr.stats.network
                sta = tr.stats.station
                netsta = f"{net}.{sta}"

                # Correct check: validate the complete NET.STA pair
                if netsta not in requested_stations:
                    continue

                tr_start = tr.stats.starttime
                tr_end = tr.stats.endtime

                # Check time overlap with the requested window
                if (tr_start <= end) and (tr_end >= start):
                    relevant_stations.add(netsta)
                    relevant_files.add(fn)

                    seg_s = max(tr_start, start)
                    seg_e = min(tr_end, end)

                    per_station_intervals[netsta].append((seg_s, seg_e))

        availability = {}
        for netsta, iv in per_station_intervals.items():
            availability[netsta] = self.merge_intervals(iv, join_tolerance=0.0)

        return relevant_files, relevant_stations, availability

    def merge_intervals(self, intervals, join_tolerance=0.0):
        if not intervals:
            return []
        iv = sorted(((min(a,b), max(a,b)) for a,b in intervals), key=lambda x: x[0])
        merged = []
        cur_s, cur_e = iv[0]
        for s, e in iv[1:]:
            if s <= cur_e + join_tolerance:
                if e > cur_e:
                    cur_e = e
            else:
                merged.append((cur_s, cur_e))
                cur_s, cur_e = s, e
        merged.append((cur_s, cur_e))
        return merged

    def get_filters(self):
        def is_true(x):
            return (isinstance(x, bool) and x) or str(x).strip().lower() in ("true", "1", "yes", "y", "on")
        out = []
        for b in self.bindings:
            if not b.get("net") or not b.get("sta"):
                continue
            key = f"{b['net']}.{b['sta']}"
            for k, v in b.items():
                if k.startswith("profiles.") and k.endswith(".pickEnable") and is_true(v):
                    p = k.split(".")[1]
                    f = b.get(f"profiles.{p}.filter")
                    if f is not None:
                        out.append({"key": key, "profile": p, "filter": f})
        return out

    def divide_stations(self, stations, num):
        from collections import defaultdict
        grouped = defaultdict(list)
        for i, sta in enumerate(sorted(stations)):
            grouped[i % num].append(sta)
        return list(grouped.values())

    def init_worker_processes(self):

        self.worker_result_queues = []
        self.worker_control_queues = []

        for i, group in enumerate(self.worker_station_groups):
            input_queue = mp.Queue()
            # A Queue would hand this to a background thread. That thread waits
            # behind the threads still pickling waveform records, so a slice
            # request sat there for the whole collect. A pipe writes it now.
            control_queue, control_send = mp.Pipe(duplex=False)
            # The result used to sit in a Queue feeder thread. The worker went
            # back to records and held the interpreter, so that thread could
            # not write the packet. send() writes it before the next record.
            result_recv, result_send = mp.Pipe(duplex=False)
            # p = mp.Process(target=self.worker_loop, args=(i, group, input_queue, result_queue, self.global_staSend_counts, self.global_delayStaSend_counts, self.global_staSet_counts))
            p = mp.Process(target=self.worker_loop, args=(i, group, control_queue, input_queue, result_send, self.global_staSend_counts, self.global_staSet_counts))
            p.start()
            self.worker_queues.append(input_queue)
            self.worker_control_queues.append(control_send)
            self.worker_result_queues.append(result_recv)
            self.worker_processes.append(p)

    def worker_loop(self, worker_id, station_list, control_queue, input_queue, result_queue, global_staSend_counts, global_staSet_counts):
        """Loop executed by each worker process."""

        logPath = os.path.join(self.ei.logDir(), f"scmlpick")
        Path(logPath).mkdir(parents=True, exist_ok=True)
        log_file = os.path.join(self.ei.logDir(), f"scmlpick/worker_{worker_id}.log")

        rotating_handler = RotatingFileHandler(
            log_file, maxBytes=5 * 1024 * 1024, backupCount=3
        )

        rotating_handler.setFormatter(stdlogging.Formatter(
            f"%(asctime)s [%(levelname)s/Worker {worker_id}] %(message)s"
        ))

        stdlogging.basicConfig(
            level=stdlogging.DEBUG,
            handlers=[
                rotating_handler,
                stdlogging.StreamHandler(sys.stdout)
            ]
        )

        core_id = worker_id  # Make sure worker_id < number of physical cores
        try:
            os.sched_setaffinity(0, {core_id})
            # stdlogging.info(f"[Worker {worker_id}] Assigned to CPU core {core_id}")
        except Exception as e:
            stdlogging.warning(f"[Worker {worker_id}] Could not set CPU affinity: {e}")

        stream = Stream()
        streamPick = Stream()
        # delayStream = Stream()
        stasPick = set()
        delayStasPick = set()
        staSend = []
        staSet = set()
        # delayStaSend = []
        # First matching (net, sta, chan) in stream, and full id in streamPick.
        # Same selection the linear scans used. Rebuilt when those lists shrink.
        stream_index = {}
        pick_index = {}
        # Spare sample buffers for exact-fit appends. Keyed by full trace id.
        grow_buffers = {}
        fast_n = 0
        merge_n = 0
        last_asm_log = 0.0

        running = True
        last_delay_warn = 0.0
        # buffered_msgs = []

        while True:

            # Control messages (PAUSE, RESUME, GET_RESULTS, RESET, TRIM_STREAMS)
            # must not wait behind the waveform backlog.
            msg = None
            try:
                if control_queue.poll():
                    msg = control_queue.recv()
            except EOFError:
                break
            except Exception as e:
                stdlogging.exception(f"[Worker {worker_id}] Unexpected error while reading control_queue: {e}")
                continue

            if msg is None:
                # Keep merging waveforms while a picker window is being built.
                # PAUSE only acknowledges the snapshot; it does not stop acquisition.
                try:
                    msg = input_queue.get(timeout=0.1)
                except queue.Empty:
                    continue
                except Exception as e:
                    stdlogging.exception(f"[Worker {worker_id}] Unexpected error while reading input_queue: {e}")
                    continue
            # except Exception as e:
            #     result_queue.send(("ERROR", worker_id, f"{type(e).__name__}: {e}"))
            #     continue

            # msg = input_queue.get()

            if msg is None:
                break

            elif msg == "PAUSE":
                result_queue.send("PAUSED")
                # continue

            elif msg == "RESUME":
                running = True
                # continue

            elif msg == "GET_RESULTS":
                #logging.debug(f"[Worker {worker_id}] Received GET_RESULTS")
                result_queue.send((worker_id, {
                    "stream": stream,
                    "staSend": staSend,
                    "staSet": list(staSet),
                    # "delayStaSend": delayStaSend,
                    "streamPick": streamPick,
                    # "delayStream": delayStream
                }))
                #logging.debug(f"[Worker {worker_id}] Sent GET_RESULTS response")
                continue


            # elif isinstance(msg, tuple) and msg[0] == "SET_STREAM":
            #     stream = msg[1]
            #     # continue

            # elif isinstance(msg, tuple) and msg[0] == "SET_STREAM_PICK":
            #     streamPick = msg[1]
            #     # continue

            # elif isinstance(msg, tuple) and msg[0] == "SET_STREAM_DELAY":
            #     delayStream = msg[1]
            #     # continue

            elif msg == "RESET":
                staSend.clear()
                staSet.clear()
                # delayStaSend.clear()
                # continue

            # if not running:
            #     input_queue.put(msg)
            #     time.sleep(0.05)
            #     continue

            elif isinstance(msg, tuple) and msg[0] == "TRIM_STREAMS":
                instructions = msg[1]
                slice_times = instructions.get("slice_times", [])
                delete_ids = set(instructions.get("delete_ids", []))

                # Last matching instruction wins, applied to the original trace,
                # which is what the nested scan did when several rows shared an id.
                slices_by_id = defaultdict(list)
                for s in slice_times:
                    slices_by_id[s["id"]].append(s)

                for i, tr in enumerate(stream):
                    specs = slices_by_id.get(tr.id)
                    if not specs:
                        continue
                    for s in specs:
                        try:
                            stream[i] = tr.slice(starttime=UTCDateTime(s["start"]), endtime=tr.stats.endtime)
                        except Exception as e:
                            stdlogging.error(f"[Worker {worker_id}] Error slicing {tr.id}: {e}")
                    grow_buffers.pop(tr.id, None)

                stdlogging.debug(f"[Worker {worker_id}] streamPick size before delete: {len(streamPick)}")
                streamPick.traces = [tr for tr in streamPick if tr.id not in delete_ids]
                # streamPick = Stream([tr for tr in streamPick if tr.id not in delete_ids])
                self._rebuild_pick_index(streamPick, pick_index)
                stdlogging.debug(f"[Worker {worker_id}] streamPick size after delete: {len(streamPick)}")

            elif msg == "WINDOW_CANDIDATES" or (isinstance(msg, tuple) and msg[0] == "SLICE_COHORT"):
                # One task must be one shared minute. Taking every trace from
                # its own start mixed stations that were minutes apart and
                # turned each straggler into its own small packet.
                try:
                    n_stream = len(stream)
                    dur_stream = 0.0
                    by_id = {}
                    for i, trc in enumerate(stream):
                        dur_stream += float(trc.stats.endtime - trc.stats.starttime)
                        by_id[trc.id] = i
                    n_pick = len(streamPick)
                    dur_pick = 0.0
                    for trc in streamPick:
                        dur_pick += float(trc.stats.endtime - trc.stats.starttime)
                    sta_send_lookup = set(staSend)
                    if msg == "WINDOW_CANDIDATES":
                        counts = {}
                        seen = set()
                        for trc in streamPick:
                            if trc.stats.station not in sta_send_lookup or trc.id in seen:
                                continue
                            seen.add(trc.id)
                            index = by_id.get(trc.id)
                            if index is None:
                                continue
                            live = stream[index]
                            duration = float(live.stats.endtime - live.stats.starttime)
                            if duration + 1e-3 < self.windowLength + self.filterShift:
                                continue
                            key = int(round(float(live.stats.starttime.timestamp) / 2.0)) * 2
                            counts[key] = counts.get(key, 0) + 1
                        n_joined = 0
                        joined = set()
                        for trc in stream:
                            if trc.id in joined or trc.stats.station not in sta_send_lookup:
                                continue
                            joined.add(trc.id)
                            n_joined += 1
                        result_queue.send((worker_id, {
                            "starts": list(counts.items()),
                            "n_joined": n_joined,
                            "n_stream": n_stream,
                            "dur_stream": dur_stream,
                            "n_pick": n_pick,
                            "dur_pick": dur_pick,
                            "staSend": list(staSend),
                            "staSet": list(staSet),
                        }))
                    else:
                        target = float(msg[1])
                        span = float(msg[2])
                        step = float(msg[3])
                        do_jump = bool(msg[4])
                        t_slice = time.perf_counter()
                        tol = 2.5
                        chunks = []
                        meta = []
                        kept = []
                        seen = set()
                        for trc in streamPick:
                            if trc.id in seen:
                                continue
                            seen.add(trc.id)
                            if trc.stats.station not in sta_send_lookup:
                                kept.append(trc)
                                continue
                            index = by_id.get(trc.id)
                            if index is None:
                                continue
                            live = stream[index]
                            start = float(live.stats.starttime.timestamp)
                            end = float(live.stats.endtime.timestamp)
                            duration = end - start
                            covers = end + 1e-3 >= target + span - tol and duration + 1e-3 >= span
                            # Jump only past traceDelay. A shorter gap is still
                            # unprocessed data and is sent from its own start.
                            jump_after = float(self.traceDelay)
                            if jump_after < step:
                                jump_after = step
                            if abs(start - target) <= tol and covers:
                                wstart = live.stats.starttime
                            elif do_jump and start < target - jump_after and covers:
                                wstart = UTCDateTime(target)
                            else:
                                wstart = None
                            if wstart is not None:
                                # Copy the window first. The tail is a second copy,
                                # so later appends cannot overwrite the packet.
                                samples, piece_start = self._owned_samples(
                                    live, wstart, wstart + span, dtype=np.float64)
                                tail, tail_start = self._owned_samples(
                                    live, wstart + step, live.stats.endtime)
                                if len(samples):
                                    meta.append((
                                        live.stats.network,
                                        live.stats.station,
                                        live.stats.location,
                                        live.stats.channel,
                                        float(live.stats.sampling_rate),
                                        float(piece_start.timestamp),
                                        int(samples.shape[0]),
                                    ))
                                    chunks.append(samples)
                                trimmed = self._trace_from_samples(live, tail, tail_start)
                                grow_buffers.pop(live.id, None)
                                if trimmed is not None:
                                    stream[index] = trimmed
                                    if float(trimmed.stats.endtime - trimmed.stats.starttime) + 1e-3 >= span:
                                        kept.append(trimmed)
                                continue
                            if do_jump and start < target - jump_after:
                                dest = UTCDateTime(target + step)
                                if not (live.stats.endtime > dest):
                                    dest = live.stats.endtime - 1.0
                                    if dest <= live.stats.starttime:
                                        continue
                                tail, tail_start = self._owned_samples(
                                    live, dest, live.stats.endtime)
                                trimmed = self._trace_from_samples(live, tail, tail_start)
                                grow_buffers.pop(live.id, None)
                                if trimmed is not None:
                                    stream[index] = trimmed
                                    if float(trimmed.stats.endtime - trimmed.stats.starttime) + 1e-3 >= span:
                                        kept.append(trimmed)
                                continue
                            kept.append(live)
                        streamPick.traces = kept
                        self._rebuild_pick_index(streamPick, pick_index)
                        if chunks:
                            blob = np.concatenate(chunks)
                            if blob.dtype != np.float64:
                                blob = blob.astype(np.float64, copy=False)
                        else:
                            blob = np.zeros(0, dtype=np.float64)
                        t_ready = time.perf_counter()
                        payload = {
                            "meta": meta,
                            "n_stream": n_stream,
                            "dur_stream": dur_stream,
                            "n_pick": n_pick,
                            "dur_pick": dur_pick,
                            "staSend": list(staSend),
                            "staSet": list(staSet),
                            "shm_path": "",
                        }
                        # Writing these bytes down the pipe took ~30 s. The
                        # packet is a file on the ram disk; the message only
                        # carries the path.
                        if blob.nbytes:
                            path = f"/dev/shm/scmlpick-{worker_id}-{time.time_ns()}.f64"
                            raw = np.ascontiguousarray(blob).tobytes()
                            with open(path, "wb") as handle:
                                handle.write(raw)
                            payload["shm_path"] = path
                        result_queue.send((worker_id, payload))
                        t_put = time.perf_counter()
                        stdlogging.info(
                            f"[Worker {worker_id}] slice n={len(meta)} "
                            f"bytes={int(blob.nbytes)} "
                            f"cut={t_ready - t_slice:.3f}s put={t_put - t_ready:.3f}s"
                        )
                except Exception:
                    stdlogging.exception(f"[Worker {worker_id}] cohort window failed")
                    result_queue.send((worker_id, {
                        "starts": [],
                        "n_joined": 0,
                        "meta": [],
                        "data": np.zeros(0, dtype=np.float64),
                        "n_stream": len(stream) if stream is not None else 0,
                        "dur_stream": 0.0,
                        "n_pick": len(streamPick) if streamPick is not None else 0,
                        "dur_pick": 0.0,
                        "staSend": list(staSend),
                        "staSet": list(staSet),
                    }))

            elif isinstance(msg, dict):
                try:
                    rec_dict = msg

                    startTime = UTCDateTime(rec_dict["starttime"])
                    endTime =  UTCDateTime(rec_dict["endtime"])
                    sta = rec_dict["station"]
                    net = rec_dict["network"]
                    loc = rec_dict["location"]
                    chan = rec_dict["channel"]
                    sampFreq = rec_dict["sampling_rate"]
                    traceID = f'{net}.{sta}.{loc}.{chan}'

                    net_sta = f"{net}.{sta}"

                    if net_sta not in station_list:
                        continue

                    try:
                        data=np.array(rec_dict["data"])
                    except Exception as e:
                        stdlogging.error(str(e))
                        stdlogging.debug('No data')
                        continue

                    header = {
                        'network': net,
                        'station': sta,
                        'location': loc,
                        'channel': chan,
                        'npts': len(data),
                        'sampling_rate': sampFreq,
                        'starttime': startTime
                    }
                    tr = Trace(data=data, header=header)

                    if tr is None or len(tr.data) == 0:
                        continue


                    now = UTCDateTime(str(Time.GMT()))

                    max_lag_seconds = 120
                    data_lag = now - endTime

                    if data_lag > max_lag_seconds:
                        now_mono = time.time()
                        if now_mono - last_delay_warn >= 30:
                            stdlogging.warning(f"[Worker {worker_id}] Delayed data detected for {net}.{sta}.{chan}: lag={data_lag:.2f}s")
                            last_delay_warn = now_mono

                    if now < self.startTime:
                        stdlogging.debug('Waiting for the processing start time %s' % self.startTime)

                    if stream:
                        key = (net, sta, chan)
                        index = stream_index.get(key)
                        if (
                            index is None
                            or index >= len(stream)
                            or stream[index].stats.network != net
                            or stream[index].stats.station != sta
                            or stream[index].stats.channel != chan
                        ):
                            index, trace = next(((i, t) for i, t in enumerate(stream) if t.stats.network == net and t.stats.station == sta and t.stats.channel == chan), (None, None))
                            if index is not None:
                                stream_index[key] = index
                        else:
                            trace = stream[index]
                        if index is not None and trace is not None:
                            tnew = self._exact_fit_append(trace, tr, grow_buffers)
                            if tnew is None:
                                tempSt = Stream([trace, tr])
                                # tempSt.merge(method=1, fill_value=0)
                                tempSt.merge(method=1, fill_value="interpolate")
                                tnew = tempSt[0]
                                grow_buffers.pop(tnew.id, None)
                                merge_n += 1
                            else:
                                fast_n += 1
                            stream[index] = tnew
                            now_mono = time.time()
                            if now_mono - last_asm_log >= 60:
                                stdlogging.info(
                                    f"[Worker {worker_id}] trace assembly fast={fast_n} merge={merge_n}"
                                )
                                last_asm_log = now_mono
                        else:
                            stream.append(tr)
                            stream_index[key] = len(stream) - 1
                            continue
                        if not trace or (stream[index].stats.endtime - stream[index].stats.starttime) <= (self.windowLength + self.filterShift) or stream[index].stats.endtime <= self.startTime:
                            continue
                    else:
                        stream.append(tr)
                        stream_index[(net, sta, chan)] = len(stream) - 1
                        continue

                    if stream[index].stats.endtime < self.startTime +  timedelta(seconds=self.windowLength):
                        # stream[index].trim(self.startTime-self.filterShift, UTCDateTime(end_time), pad=True, fill_value=0)
                        trimmed = self.safe_trim_edge_pad(stream[index],self.startTime - self.filterShift,endTime)
                        if trimmed is not None:
                            stream[index] = trimmed
                        continue

                    base_time = self.startTime - self.filterShift
                    base_second = base_time.second

                    expected_seconds = [(base_second + i * self.timeShift) % 60 for i in range(60 // self.timeShift)]

                    trace_second = stream[index].stats.starttime.second + stream[index].stats.starttime.microsecond / 1e6
                    in_window = any(abs(trace_second - s) < 1 for s in expected_seconds)

                    if not in_window:
                        stdlogging.info(f"Start time not in expected timeMarks: {trace_second:.3f}s not near {expected_seconds}")
                        stdlogging.info(f"Trace {stream[index]}")

                        valid_secs = [s for s in expected_seconds if s <= trace_second]
                        chosen_sec = max(valid_secs) if valid_secs else max(expected_seconds)
                        new_start = stream[index].stats.starttime.replace(second=chosen_sec, microsecond=0)

                        try:
                            # stream[index].trim(new_start, UTCDateTime(end_time), pad=True, fill_value=0)
                            trimmed = self.safe_trim_edge_pad(stream[index],new_start,endTime)
                            if trimmed is not None:
                                stream[index] = trimmed
                                stdlogging.info(f"Trimmed using aligned second: {new_start}")
                            else:
                                stdlogging.warning(f"No data remaining after trimming {stream[index].id}")
                        except Exception as e:
                            stdlogging.error(f"Error trimming trace {stream[index]} with new_start={new_start}: {e}")


                    if stream[index].stats.endtime - stream[index].stats.starttime >= self.windowLength + self.filterShift:
                        index_found = pick_index.get(traceID)
                        if index_found is None or index_found >= len(streamPick) or streamPick[index_found].id != traceID:
                            index_found = next((j for j, trp in enumerate(streamPick) if trp.id == traceID), None)
                        if index_found is None:
                            streamPick.append(stream[index])
                            pick_index[traceID] = len(streamPick) - 1
                            stasPick.add(stream[index].stats.station)
                        else:
                            streamPick[index_found] = stream[index]
                            pick_index[traceID] = index_found
                            stasPick.add(stream[index].stats.station)
                    else:
                        continue

                    # Adding stations with data for all channels avail. to staSend
                    staSend,stasPick = self.checkChann(stream[index],stasPick,streamPick,staSend)

                    removed_streams = [trace for trace in stream if (trace.stats.endtime - trace.stats.starttime) > self.timeRemoveTrace]
                    stream = [trace for trace in stream if (trace.stats.endtime - trace.stats.starttime) <= self.timeRemoveTrace]

                    if removed_streams:
                        stdlogging.info(f"Removed streams, (length > {self.timeRemoveTrace} secs):")
                        stdlogging.info("\n".join(str(trace) for trace in removed_streams))
                        for gone in removed_streams:
                            grow_buffers.pop(gone.id, None)
                        self._rebuild_stream_index(stream, stream_index)

                    # Check delay for stations in memory.
                    # One clock reading per record: the previous code asked for
                    # the clock twice per trace, which only moved these delays
                    # by the time spent inside the loop.
                    if streamPick and staSend:
                        now_gmt = UTCDateTime(str(Time.GMT()))
                        sta_send_lookup = set(staSend)
                        for trace in streamPick:
                            sta = trace.stats.station
                            if sta in sta_send_lookup and sta not in staSet:
                                delayEnd = now_gmt - trace.stats.endtime # Leave here but this time is different than the one use in oneMinuteStream (to evaluate).
                                delayStart = now_gmt - trace.stats.starttime # Same than oneMinuteStream this is the correct time to count the delay.
                                if delayEnd >= self.firstWait or delayStart >= self.firstWait + self.windowLength:
                                    staSet.add(sta)

                    global_staSend_counts[worker_id] = len(staSend)
                    # global_delayStaSend_counts[worker_id] = len(delayStaSend)
                    global_staSet_counts[worker_id] = len(staSet)

                except Exception as e:
                    stdlogging.exception(f"Unhandled error in worker {worker_id}")
                    # result_queue.send(("ERROR", worker_id, str(e)))

    def _paramset_to_dict(self, pset):
        """Flatten DataModel::ParameterSet to a {name: value} dict."""
        out = {}
        if pset is None:
            return out
        for i in range(pset.parameterCount()):
            p = pset.parameter(i)
            out[p.name()] = p.value()
        return out

    def profilesConfig(self):
        profiles = []
        profiles = self.configGetStrings('pipelines.profiles')

        try:
            self.standard = self.configGetBool('pipelines.Standard')
        except Exception as e:
            logging.info('Standard could not be read : %s' % e)
        try:
            self.simulation = self.configGetBool('pipelines.Simulation')
        except Exception as e:
            logging.info('Simulation could not be read : %s' % e)
        try:
            self.bulk = self.configGetBool('pipelines.Bulk')
        except Exception as e:
            logging.info('Bulk could not be read : %s' % e)
        try:
            self.bulkInterval = self.configGetInt('pipelines.bulkInterval')
        except Exception as e:
            logging.info('bulkInterval could not be read : %s' % e)

        if len(profiles) != 0:
            for profile in profiles:
                profDic = {}
                profDic['name'] = profile              
                try:
                    profDic['pickTargetGroup'] = self.configGetString('pipelines.profiles.'+profile+'.pickTargetGroup')
                except Exception as e:
                    logging.error(str(e))
                    logging.warning('Error when reading pipelines.profiles.'+profile+'.pickTargetGroup')
                    logging.warning('setting default pickTargetGroup')
                    profDic['pickTargetGroup'] = ''
                    pass
                try:
                    profDic['pickSimulTargetGroup'] = self.configGetString('pipelines.profiles.'+profile+'.pickSimulTargetGroup')
                except Exception as e:
                    logging.error(str(e))
                    logging.warning('Error when reading pipelines.profiles.'+profile+'.pickSimulTargetGroup')
                    logging.warning('setting default pickSimulTargetGroup')
                    profDic['pickSimulTargetGroup'] = ''
                    pass
                try:
                    profDic['pickBulkTargetGroup'] = self.configGetString('pipelines.profiles.'+profile+'.pickBulkTargetGroup')
                except Exception as e:
                    logging.error(str(e))
                    logging.warning('Error when reading pipelines.profiles.'+profile+'.pickBulkTargetGroup')
                    logging.warning('setting default pickBulkTargetGroup')
                    profDic['pickBulkTargetGroup'] = ''
                    pass
                try:
                    profDic['locTargetGroup'] = self.configGetString('pipelines.profiles.'+profile+'.locTargetGroup')
                except Exception as e:
                    logging.error(str(e))
                    logging.warning('Error when reading pipelines.profiles.'+profile+'.locTargetGroup')
                    logging.warning('setting default locTargetGroup')
                    profDic['locTargetGroup'] = ''
                    pass

                try:
                    profDic['authorTarget'] = self.configGetString('pipelines.profiles.'+profile+'.authorTarget')
                except Exception as e:
                    logging.error(str(e))
                    logging.warning('Error when reading pipelines.profiles.'+profile+'.authorTarget')
                    logging.warning('setting default authorTarget')
                    profDic['authorTarget'] = ''
                    pass

                try:
                    profDic['stations'] = self.configGetStrings('pipelines.profiles.'+profile+'.stations')
                except Exception as e:
                    logging.error(str(e))
                    logging.warning('error when reading pipelines.profiles.'+profile+'.stations')
                    logging.warning('setting stations = ""')
                    profDic['stations'] = ''
                    pass

                try:
                    profDic['region'] = self.configGetString('pipelines.profiles.'+profile+'.region')
                except Exception as e:
                    logging.error(str(e))
                    logging.warning('error when reading pipelines.profiles.'+profile+'.region')
                    logging.warning('setting stations = ""')
                    profDic['region'] = ''
                    pass

                try:
                    profDic['filtersFile'] = self.configGetString('pipelines.profiles.'+profile+'.filtersFile')
                except Exception as e:
                    logging.error(str(e))
                    logging.warning('error when reading pipelines.profiles.'+profile+'.filtersFile')
                    logging.warning('setting filtersFile = ""')
                    profDic['filtersFile'] = ''
                    pass
                self.profiles.append(profDic)
        else:
            logging.warning('No profiles configured. Nothing to do')
            pass

    def _load_bindings_from_db(self):
        cfgMod = self.configModule()
        # cfg = cfgMod.config()

        for i in range(cfgMod.configStationCount()):
            st = cfgMod.configStation(i)  # ConfigStation
            key = (st.networkCode(), st.stationCode())
            for s in range(st.setupCount()):
                pid = st.setup(s).parameterSetID()
                mdName = st.setup(s).name()
                # cfg_setup = dm.findSetup(st, self.module)
                p = dm.ParameterSet.Find(pid)
                params = {}
                if mdName == self.name():
                    for i in range(p.parameterCount()):
                        p_i = p.parameter(i)
                        params[p_i.name()] = p_i.value()
                    params['net'], params['sta'] = key
                    # print(st.setup(s).name())
                    # print(params)
                    self.bindings.append(params)
        return

    def updateStreams(self):
        # streamIDs = self.configStreams()
        streamIDs = self.currentStreams()
        for streamID in streamIDs:
            for sta in self.all_station_codes:
                staCheck = False
                if (streamID[0] == sta.split('.')[0] and streamID[1] == sta.split('.')[1]):
                    staCheck = True
                if staCheck:
                        if streamID[1] in self.stasDict:
                            self.stasDict[streamID[1]].append(streamID[3])
                        else:
                            self.stasDict[streamID[1]] = [streamID[3]]
                        self.initStreams.append(streamID)
                        self.recordStream().addStream(*streamID)
        return

    def configStreams(self):
        streamIDs=[]
        cfg = self.configModule()
        inv = Inventory.Instance().inventory()
        for i in range(cfg.configStationCount()):
            cfg_sta = cfg.configStation(i)
            net = cfg_sta.networkCode()
            sta = cfg_sta.stationCode()
            nets = inv.networkCount()
            for n in range(nets):
                network = inv.network(n)
                if network.code() == net:
                    stas = network.stationCount()
                    for s in range(stas):
                        station = network.station(s)
                        if station.code() == sta:
                            locs = station.sensorLocationCount()
                            for l in range(locs):
                                location = station.sensorLocation(l)
                                loc = location.code()
                                chans = location.streamCount()
                                for c in range(chans):
                                    channel = location.stream(c)
                                    chan = channel.code()
                                    if chan[0:2] in self.whiteChanns:
                                        streamIDs.append([net, sta, loc, chan])
        return streamIDs

    def currentStreams(self):
        now = Time.GMT()
        streamIDs=[]
        inv = Inventory.Instance()
        nets = inv.inventory().networkCount()
        for n in range(nets):
            network = inv.inventory().network(n)
            net = network.code()
            stas = network.stationCount()
            for s in range(stas):
                station = network.station(s)
                sta = station.code()
                station_now = False
                station_now = inv.getStation(network.code(),sta,now)
                if station_now:
                    staCode = station_now.code()
                    locs = station_now.sensorLocationCount()
                    for l in range(locs):
                        location = station_now.sensorLocation(l)
                        loc = location.code()
                        loc_now = False
                        loc_now = inv.getSensorLocation(network.code(),staCode,loc,now)
                        if loc_now:
                            locCode = loc_now.code()
                            chans = location.streamCount()
                            for c in range(chans):
                                channel = location.stream(c)
                                chan = channel.code()
                                if chan[0:2] in self.whiteChanns:
                                    chan_now = False
                                    chan_now = inv.getStream(network.code(),staCode,locCode,chan,now)
                                    if chan_now:
                                        chanCode = chan_now.code()
                                        sid = [net, staCode, locCode, chanCode]
                                        if sid not in streamIDs:
                                            streamIDs.append([net, staCode, locCode, chanCode])
        return streamIDs

    def handleRecord(self, rec):
        #logging.debug(f"[Main] handleRecord called at {UTCDateTime.now()}")
        self.recordDispatch(rec)
        now_mono = time.time()
        if now_mono - getattr(self, "_last_qwarn", 0) >= 30:
            self._last_qwarn = now_mono
            for i, q in enumerate(self.worker_queues):
                try:
                    qsize = q.qsize()
                    if qsize > 100:
                        logging.warning(f"[Main] Queue size for worker {i} is high: {qsize}")
                except NotImplementedError:
                    logging.debug(f"[Main] Queue size not supported for worker {i}")

        if self.stream_lock.locked() or time.time() < self._hold_until:
            return
        total_staSend = sum(self.global_staSend_counts[:])
        total_staSet = sum(self.global_staSet_counts[:])
        if total_staSend < self.minStasBulk or total_staSet < self.minStasBulk:
            return
        # One pass at a time. Threads that waited on the lock each sent again
        # and split one minute into a small packet plus the real one.
        if not self._minute_flight.acquire(blocking=False):
            return
        threading.Thread(target=self.run_minute_stream_in_thread, daemon=True).start()

    def run_minute_stream_in_thread(self):
        try:
            if self.stream_lock.locked():
                return

            total_staSend = sum(self.global_staSend_counts[:])
            total_staSet = sum(self.global_staSet_counts[:])
            if total_staSend < self.minStasBulk or total_staSet < self.minStasBulk:
                return

            with self.stream_lock:
                try:
                    self.run_minute_stream()
                    logging.debug("Running run_minute_stream in new thread")
                except Exception as e:
                    logging.error(f"[run_minute_stream_in_thread] Exception: {e}")
        finally:
            self._minute_flight.release()

    def run_minute_stream(self):
        # The wait gate used to pickle every waveform first. That copy is what
        # stretched each cycle past the 40 s step and let the buffers reach
        # timeRemoveTrace. Counts already live on the workers.
        total_staSend = sum(self.global_staSend_counts[:])
        total_staSet = sum(self.global_staSet_counts[:])

        self.sendNow = False
        if self.wait:
            delay = UTCDateTime(str(Time.GMT())) - self.sendTime
            if delay >= self.maxWait:
                self.wait = False
            elif delay >= self.secondWait and total_staSend > 0:
                self.sendNow = True

        if (total_staSend >= self.minStasBulk and total_staSet >= self.minStasBulk and self.wait == False) or self.sendNow:

            if self.sendNow:
                logging.info(f"Sending now due to second delay")
                self.wait = False

            else:
                logging.info(f"Sending now due to first delay")
                self.sendTime = UTCDateTime(str(Time.GMT()))
                self.wait = True

            sent = self.minuteStream('realtime', self.params)
            if not sent:
                self.wait = False
                self.sendNow = False

    def gather_worker_results(self):

        worker_results = {}

        for q in self.worker_control_queues:
            q.send("GET_RESULTS")

        logging.warning(f"Started {len(self.worker_queues)} worker processes.")

        for i, result_q in enumerate(self.worker_result_queues):
            try:
                start_time = time.time()
                #worker_id, result = result_q.get(timeout=2.5)
                worker_id, result = result_q.recv()
                worker_results[worker_id] = result
                logging.debug(f"[Main] Got result from worker {worker_id} in {time.time() - start_time:.3f} sec")
            except queue.Empty:
                logging.warning(f"[Main] Worker {i} did not respond in time.")
            except Exception as e:
                logging.error(f"[Main] Unexpected error from worker {i}: {e}")

        streams = []
        streamPicks = []
        # delayStreams = []
        combined_staSend = []
        # combined_delayStaSend = []
        combined_staSet = set()

        for i in range(self.numWorkers):
            if i in worker_results:
                result = worker_results[i]
                streams.append(result["stream"])
                streamPicks.append(result["streamPick"])
                # delayStreams.append(result["delayStream"])
                combined_staSend += result.get("staSend", [])
                # combined_delayStaSend += result.get("delayStaSend", [])
                combined_staSet.update(result.get("staSet", []))
            else:
                logging.warning(f"[Main] Missing result from worker {i}, inserting empty defaults")
                streams.append(Stream())
                streamPicks.append(Stream())
                # delayStreams.append(Stream())

        # return streams, combined_staSend, combined_staSet, combined_delayStaSend, streamPicks, delayStreams
        return streams, combined_staSend, combined_staSet, streamPicks

    def reset_worker_output(self):
        for q in self.worker_control_queues:
            q.send("RESET")
            q.send("RESUME")

    def recordDispatch(self, rec):
        # try:
        if not rec.data():
            return

        dataObj = FloatArray.Cast(rec.data())
        if not dataObj:
            logging.debug("No data available in record.")
            return

        # Extract raw data as a list of floats
        data = [dataObj.get(i) for i in range(dataObj.size())]

        # Extract record metadata
        net = rec.networkCode()
        sta = rec.stationCode()
        loc = rec.locationCode()
        chan = rec.channelCode()
        sampFreq = rec.samplingFrequency()
        startTime = rec.startTime()
        endTime = rec.endTime()

        # Create a serializable dictionary
        rec_dict = {
            "network": net,
            "station": sta,
            "location": loc,
            "channel": chan,
            "sampling_rate": sampFreq,
            "starttime": UTCDateTime(str(startTime)).timestamp,
            "endtime": UTCDateTime(str(endTime)).timestamp,
            "data": data
        }

        # Find the corresponding worker group and send the record
        net_sta = f"{net}.{sta}"
        for i, group in enumerate(self.worker_station_groups):
            if net_sta in group:
                max_lag_seconds = 600
                now = UTCDateTime.now()
                rec_end = UTCDateTime(str(endTime))
                lag = now - rec_end

                if lag > max_lag_seconds:
                    logging.warning(f"[recordDispatch] Skipping delayed record {net}.{sta}.{chan}, lag={lag:.1f}s")
                    return

                self.worker_queues[i].put(rec_dict)
                break
        # except Exception as e:
        #     logging.error(f"Failed to dispatch record: {e}")

    def checkCommonChan(self, tnew, streamPick, delayStream):
        if not tnew:
            return
        station_tnew = tnew.stats.station
        if any(trace.stats.station == station_tnew for trace in streamPick):
            traces_to_move = [trace for trace in delayStream if trace.stats.station == station_tnew]
            if traces_to_move:
                streamPick += Stream(traces_to_move)
                delayStream = Stream([trace for trace in delayStream if trace.stats.station != station_tnew])
        return(streamPick,delayStream)

    def _recv_worker(self, conn):
        """Read one worker reply. The waveform bytes travel outside pickle."""
        msg = conn.recv()
        if not (isinstance(msg, tuple) and len(msg) == 2):
            return msg
        worker_id, result = msg
        if isinstance(result, dict) and "shm_path" in result:
            path = result.pop("shm_path")
            if path:
                try:
                    with open(path, "rb") as handle:
                        raw = handle.read()
                    result["data"] = np.frombuffer(raw, dtype=np.float64).copy()
                finally:
                    try:
                        os.unlink(path)
                    except OSError:
                        pass
            else:
                result["data"] = np.zeros(0, dtype=np.float64)
        return worker_id, result

    def _worker_round(self, message):
        for q in self.worker_control_queues:
            q.send(message)
        parts = []
        for result_q in self.worker_result_queues:
            _worker_id, result = self._recv_worker(result_q)
            parts.append(result)
        return parts

    def _choose_cohorts(self, parts, step):
        # Minutes within one step of the newest start are the live edge.
        # A start older than that, but still inside traceDelay, is sent from
        # its own start so the samples in between are not dropped. Only a
        # start older than traceDelay is left for the live minute to absorb.
        counts = {}
        for result in parts:
            for start, n in result.get("starts", []):
                if int(n) <= 0:
                    continue
                counts[int(start)] = counts.get(int(start), 0) + int(n)
        if not counts:
            return [], 0
        ordered = sorted(counts.items())
        newest = ordered[-1][0]
        horizon = newest - float(step) - 2.5
        jump_after = float(self.traceDelay)
        if jump_after < float(step):
            jump_after = float(step)
        limit = newest - jump_after
        recent = [item for item in ordered if item[0] >= horizon]
        if not recent:
            recent = [ordered[-1]]
        if len(recent) <= 3:
            chosen = list(recent)
        else:
            biggest = max(recent, key=lambda item: item[1])
            newest_item = recent[-1]
            older = [item for item in recent if item[0] not in (biggest[0], newest_item[0])]
            chosen = [biggest, newest_item]
            if older:
                chosen.append(older[-1])
            chosen = sorted({item[0]: item for item in chosen}.values())
        catchup = [item for item in ordered if limit <= item[0] < horizon]
        if catchup:
            chosen.append(catchup[0])
            chosen = sorted({item[0]: item for item in chosen}.values())
        skipped = len([item for item in ordered if item[0] < limit])
        return chosen, skipped

    def minuteStream(self, tp, params):
        # Real-time scoring uses the last 60 s of each trace it is given.
        # Every trace in one task therefore has to cover the same minute.
        # A station that already has that minute is sent now, even if only a
        # few stations are there yet. Holding it would publish the pick late.
        span = float(self.windowLength + self.filterShift)
        step = float(self.windowLength - self.timeShift)
        if step <= 0:
            step = float(self.windowLength)

        parts = self._worker_round("WINDOW_CANDIDATES")
        n_stream = sum(int(p["n_stream"]) for p in parts)
        dur_stream = sum(float(p["dur_stream"]) for p in parts)
        n_pick = sum(int(p["n_pick"]) for p in parts)
        dur_pick = sum(float(p["dur_pick"]) for p in parts)
        sta_send = []
        sta_set = set()
        for p in parts:
            sta_send.extend(p.get("staSend", []))
            sta_set.update(p.get("staSet", []))
        logging.info(f"[Summary] Total stream traces: {n_stream}, total duration: {dur_stream:.1f} s")
        logging.info(f"[Summary] Total streamPick traces: {n_pick}, total duration: {dur_pick:.1f} s")
        logging.info(f"[Summary] staSend size: {len(sta_send)}, staSet size: {len(sta_set)}")

        chosen, skipped = self._choose_cohorts(parts, step)
        if not chosen:
            self._hold_until = time.time() + 5.0
            logging.info("ONE MINUTE STREAM windows=0")
            return 0
        if skipped:
            logging.info(
                f"Skipped {skipped} cohorts older than {int(self.traceDelay)}s; "
                f"those traces join the live minute"
            )
        newest = max(start for start, _count in chosen)
        live_pool = [item for item in chosen if item[0] >= newest - step - 2.5]
        if not live_pool:
            live_pool = chosen
        live_target = max(live_pool, key=lambda item: item[1])[0]
        sent = 0
        for _index, (target, _count) in enumerate(chosen):
            do_jump = target == live_target
            t_collect = time.time()
            sliced = self._worker_round(("SLICE_COHORT", float(target), span, step, do_jump))
            t_after_collect = time.time()
            meta = []
            blobs = []
            for result in sliced:
                meta.extend(result.get("meta", []))
                data = result.get("data")
                if data is not None and len(data):
                    blobs.append(data)
            if not meta:
                continue
            blob = np.concatenate(blobs) if blobs else np.zeros(0, dtype=np.float64)
            sent += 1
            startMinute = UTCDateTime(float(target))
            endMinute = startMinute + span
            stream_ref = ray.put((meta, blob))
            t_after_put = time.time()
            self.task_queue.put(self._launch_run_picker(startMinute, endMinute, stream_ref, params))
            self.log_queue_size()
            logging.info(
                f"Task for data {startMinute}, {endMinute}, "
                f"{len(meta)} traces, window {sent}/{len(chosen)}, "
                f"collect={t_after_collect - t_collect:.1f}s put={t_after_put - t_after_collect:.1f}s"
            )

        logging.info(f"ONE MINUTE STREAM windows={sent}")
        self.reset_worker_output()
        for i in range(self.numWorkers):
            self.global_staSend_counts[i] = 0
            self.global_staSet_counts[i] = 0
        logging.info("The main process continues to generate and launch tasks.")
        return sent

    def checkChann(self, tnew, stasPick, streamPick, staSend):
        if not tnew:
            return
        station_tnew = tnew.stats.station
        if station_tnew in stasPick:
            checkSta = all(
                any(trace.stats.station == station_tnew and recChann == trace.stats.channel for trace in streamPick)
                for recChann in self.stasDict.get(station_tnew, [])
            )
            if checkSta and station_tnew not in staSend:
                staSend.append(station_tnew)
                stasPick.discard(station_tnew)
        return(staSend,stasPick)

    @ray.remote
    class DedupRegistry:
        def __init__(self): self.seen = set()
        def add_if_absent(self, key):
            if key in self.seen: return False
            self.seen.add(key); return True

    @classmethod
    def get_dedup_registry(cls):
        if cls._REGISTRY_HANDLE is not None:
            return cls._REGISTRY_HANDLE
        with cls._REGISTRY_LOCK:
            if cls._REGISTRY_HANDLE is not None:
                return cls._REGISTRY_HANDLE
            try:
                actor = ray.get_actor("dedup_registry")
            except ValueError:
                try:
                    actor = cls.DedupRegistry.options(name="dedup_registry",
                                                      lifetime="detached").remote()
                except Exception:
                    actor = ray.get_actor("dedup_registry")
            cls._REGISTRY_HANDLE = actor
            return actor

    def job_key(job):
        net, sta, t0, t1 = job
        return (net, sta, float(t0), float(t1))

    def chunk_time(self, starttime, endtime, dt, overlap):
        times_list = [[starttime, endtime]]
        logging.debug(f"[{datetime.now()}] 1 time chunk from {starttime} to {endtime} (single window).")
        return times_list

    def build_jobs_with_coverage(base_chunks, availability, min_coverage=0.5):
        jobs = []
        for netsta, intervals in availability.items():
            net, sta = netsta.split(".")
            for t0, t1 in base_chunks:
                dur = float(t1 - t0)
                if dur <= 0:
                    continue
                cov = 0.0
                for a, b in intervals:
                    s = max(t0, a)
                    e = min(t1, b)
                    if e > s:
                        cov += float(e - s)
                    if cov >= min_coverage * dur:
                        jobs.append((net, sta, t0, t1))
                        break
        return jobs

    def _launch_run_picker(self, start_time, end_time, stream_ref, params):
        """Dispatch one time window.

        In model-actor mode the CPU pool is already held by the actors, so
        this dispatcher asks for no CPU of its own. In task mode it keeps the
        previous cost of one CPU.
        """
        remote_fn = scmlpick.run_picker
        if getattr(self, "execution", "modelactor") == "modelactor":
            remote_fn = scmlpick.run_picker.options(num_cpus=0)
        return remote_fn.remote(start_time, end_time, stream_ref, params)

    @staticmethod
    @ray.remote(max_retries=1)
    def run_picker(start_time,end_time,stream_ref,params):
        # registry = scmlpick.get_dedup_registry()
        if isinstance(stream_ref, ray.ObjectRef):
            stream = ray.get(stream_ref)
        else:
            stream = stream_ref
        if isinstance(stream, tuple) and len(stream) == 2 and isinstance(stream[0], list):
            stream = scmlpick._stream_from_packets(stream[0], stream[1])
        elif isinstance(stream, list):
            stream = scmlpick._stream_from_packets(stream, None)
        # Get picker tasks
        start_time = UTCDateTime(start_time)
        end_time = UTCDateTime(end_time)
        stations = []

        # Prepare tasks for EQCCT picking
        if params['playback'] and params['mseed']:
            stations = params['stations']
            availability = params['availability']
            times_list = params['time_list']
            logging.debug('Sending stations to EQCCT %s'% stations)
            jobs = scmlpick.build_jobs_with_coverage(times_list,availability, min_coverage=0.5)
            # tasks = [[f"({i+1}/{len(times_list)})", times_list[i][0], times_list[i][1], stations] for i in range(len(times_list))]
        else:
            for trace in stream:
                # station = f'{trace.stats.network}.{trace.stats.station}.{trace.stats.location}.{trace.stats.channel}'
                station = f'{trace.stats.network}.{trace.stats.station}'
                if station not in stations:
                    stations.append(station)
            times_list = [[start_time, end_time]]
            logging.debug('Sending stations to EQCCT %s'% stations)
            # tasks = [[f"({i+1}/{len(times_list)})", times_list[i][0], times_list[i][1], stations] for i in range(len(times_list))]
            sta_pairs = [tuple(s.split(".", 1)) for s in stations]
            jobs = [(net, sta, t0, t1) for (net, sta), (t0, t1) in product(sta_pairs, times_list)]

        print(jobs)
        total = len(jobs)
        if total == 0:
            return {"info": "no jobs", "picks": []}

        counts = Counter(scmlpick.job_key(j) for j in jobs)
        dups = [(k, c) for k, c in counts.items() if c > 1]
        if dups:
            print(f"[DUP] {len(dups)} claves duplicadas en jobs:")
            for (net, sta, t0, t1), c in dups[:10]:
                print(f"  {net}.{sta} {t0}->{t1} se repite {c} veces")
        else:
            print("[OK] No jobs duplicated.")

        params_ref = ray.put(params)

        picks = []
        tasks_queue = []
        it = iter(jobs)
        max_tasks_queue = params['maxTasksQueue']
        # TASK_TIMEOUT = 300

        stream_ref_pick = ray.put(stream)

        def submit_job(job):
            if params.get("execution", "modelactor") == "modelactor":
                actors = params["model_actors"]
                turn = params.get("_actor_turn", 0)
                params["_actor_turn"] = turn + 1
                return actors[turn % len(actors)].predict_station.remote(
                    job, stream_ref_pick, params_ref
                )
            # Task mode. max_calls exits the worker after N finished stations.
            # The station in progress is not cut; Ray reads its result first.
            picker_remote = params.get("picker_remote")
            if picker_remote is None:
                picker_remote = ray.remote(max_calls=int(params.get("maxCalls", 300)), max_retries=1)(
                    scmlpick.picker
                )
            return picker_remote.remote(job, stream_ref_pick, params_ref)

        for _ in range(min(max_tasks_queue, total)):
            try:
                job = next(it)
                # key = scmlpick.job_key(job)
                # if ray.get(registry.add_if_absent.remote(key)):
                tasks_queue.append(submit_job(job))
                # else:
                    # print(f"[dedup] skipped {key}")
            except StopIteration:
                break

        logging.debug(f"[{datetime.now()}] Started station×time matrix ({total} jobs).")

        while tasks_queue:
            tasks_finished, tasks_queue = ray.wait(tasks_queue, num_returns=1, timeout=None)
            for finished_task in tasks_finished:
                try:
                    picks_parall = ray.get(finished_task)
                    if not picks_parall.get("ok", True):
                        logging.warning(f"Task skipped: {picks_parall.get('error')}")
                        continue
                    logging.info(picks_parall.get("info", ""))
                    picks.extend(picks_parall.get("picks", []))
                except ray.exceptions.RayTaskError as e:
                    logging.warning(f"Task failed: {e.as_instance_of_cause()}")
                    continue
                except ray.exceptions.RayError as e:
                    logging.warning(f"Ray error: {e}")
                    continue
            try:
                while len(tasks_queue) < max_tasks_queue:
                    job = next(it)
                    # key = scmlpick.job_key(job)
                    # if ray.get(registry.add_if_absent.remote(key)):
                    tasks_queue.append(submit_job(job))
                    # else:
                        # logging.debug(f"[dedup] skipped {key}")
            except StopIteration:
                pass
        return picks

    def log_queue_size(self):
        current_size = self.task_queue.qsize()
        if current_size != self.last_queue_size:
            logging.info(f"Pending tasks on the monitor: {current_size}")
            self.last_queue_size = current_size

    def monitorTasks(self):
        results = []

        while not self.tasks_ids_end.is_set() or not self.task_queue.empty():
            # We check the completed results without blocking
            try:
                tasks_ids = []

                for _ in range(10):
                    try:
                        tasks_ids.append(self.task_queue.get(timeout=1))
                        # tasks_ids.append(self.task_queue.get_nowait())
                    except queue.Empty:
                        break

                # while not self.task_queue.empty():
                    # tasks_ids.append(self.task_queue.get_nowait())

                if tasks_ids:
                    results_ready, remaining_tasks = ray.wait(tasks_ids, num_returns=min(10, len(tasks_ids)), timeout=1)
                    #results_ready, tasks_ids[:] = ray.wait(tasks_ids, num_returns=len(tasks_ids), timeout=1)

                    # We process the results that are ready
                    for result_id in results_ready:
                        try:
                            result = ray.get(result_id)
                            # logging.info(f"Result received on the monitor: {result}")
                            # picks = self.scPhase(result)
                            picks = self.scPhase(result)
                            results.append(result)
                            if self.simulation:
                                self._pacer_submit(picks)
                            if self.bulk:
                                for pick in picks:
                                    self.add_pick_to_bulk(pick)
                        except Exception as task_error:
                            logging.error("Error while processing task {}".format(task_error))
                            logging.error(traceback.format_exc())

                    for task in remaining_tasks:
                        self.task_queue.put(task)

                self.log_queue_size()

            except Exception as e:
                logging.error("Task Monitor Error {}".format(e))
                logging.error(traceback.format_exc())

        logging.info(f"The monitor has processed all the results.")
        return results

    @staticmethod
    def picker(task,stream_ref_pick,params_ref):
        try:
            if isinstance(stream_ref_pick, ray.ObjectRef):
                stream = ray.get(stream_ref_pick)
            else:
                stream = stream_ref_pick
            picks = None

            if isinstance(params_ref, ray.ObjectRef):
                params = ray.get(params_ref)
            else:
                params = params_ref

            picks = mseed_predictor(stream = stream,
                            filterShift    = params['filterShift'],
                            wfinfo  = task,
                            files = params['files'],
                            P_threshold   = params['P_threshold'],
                            S_threshold   = params['S_threshold'],
                            normalization_mode = params['normalization_mode'],
                            overlap       = params['overlap'],
                            batch_size    = params['batch_size'],
                            overwrite     = params['overwrite'],
                            p_model       = params['p_model'],
                            s_model       = params['s_model'],
                            architecture  = params['architecture'],
                            numCPUs       = params['numCPUs'],
                            gpu_id        = params['gpu_id'],
                            gpu_limit     = params['gpu_limit'],
                            stations_filters = params["df_filters"],
                            playback = params["playback"],
                            precision = params.get("precision", "bf16"),
                            detection_threshold = params.get("detection_threshold", 0.3))
            picks["ok"] = True
            return picks
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def scPhase(self,picks):
        # Playback rewrites the output file after each result. Keep one
        # EventParameters for the run so earlier picks stay in the file.
        if self.playback:
            ep = getattr(self, "_play_ep", None)
            if ep is None:
                ep = EventParameters()
                self._play_ep = ep
        else:
            ep = EventParameters()
        resPicks = []
        for pickData in picks:
            logging.info(str(pickData))
            if pickData['PdateTime']:
                PpickID, pick = self.scPick(pickData, 'P', 'PdateTime', 'p_prob')
                ep.add(pick)
                resPicks.append(pick)
                if pickData['SdateTime']:
                    pickData['PpickID'] = PpickID
                    SpickID, pick = self.scPick(pickData, 'S', 'SdateTime', 's_prob')
                    ep.add(pick)
                    resPicks.append(pick)
            elif pickData['SdateTime'] and getattr(self, 'architecture', None) == 'eqtransformer':
                SpickID, pick = self.scPick(pickData, 'S', 'SdateTime', 's_prob')
                ep.add(pick)
                resPicks.append(pick)
        if self.playback:
            self.writeXMLObj(ep)
            # self.writeXMLObj(comm)
        return resPicks

    def scPick(self,pickData,phaseHint,strDate,strProp):
        pick = Pick.Create()
        Ptime = pickData[strDate]
        scPtime = Ptime.strftime('%Y-%m-%d %H:%M:%S.%f')
        scPtime = Time()
        scPtime.set(Ptime.year,Ptime.month,Ptime.day,Ptime.hour,Ptime.minute,Ptime.second,Ptime.microsecond)
        timeQ = TimeQuantity()
        timeQ.setValue(scPtime)
        # timeQ.setUncertainty(float(pickData[strProp]))
        pick.setTime(timeQ)
        propValue = str(pickData[strProp])
        comm = Comment()
        comm.setId('eqcctProb')
        comm.setText(propValue)
        ci = CreationInfo()
        ci.setCreationTime(Time().GMT())
        ci.setAgencyID(self.agencyID())
        ci.setAuthor(self.author())
        comm.setCreationInfo(ci)
        pick.add(comm)
        net_sta = f"{pickData['trace_name'].split('.')[0]}.{pickData['trace_name'].split('.')[1]}"
        staName = pickData['trace_name'].split('.')[1]
        freqmin = 1.0
        freqmax = 45.0
        filterID = f"BW(2,{freqmin},{freqmax})"
        try:
            f = next(d for d in self.df_filters if d["key"].split(".", 1)[-1] == staName)["filter"]
            freqmin, freqmax = sorted(float(x) for x in f[f.index("(")+1:f.index(")")].split(",")[1:3])
            filterID = f"BW(2,{freqmin},{freqmax})"
        except Exception as e:
            logging.error(str(e))
            pass

        wfID = WaveformStreamID()
        wfID.setNetworkCode(pickData['trace_name'].split('.')[0])
        wfID.setStationCode(pickData['trace_name'].split('.')[1])
        wfID.setLocationCode(pickData['trace_name'].split('.')[2])
        wfID.setChannelCode(pickData['trace_name'].split('.')[3])
        pick.setWaveformID(wfID)
        phase = Phase()
        phase.setCode(phaseHint)
        pick.setPhaseHint(phase)
        method_id = {
            'eqcct': 'EQCCT',
            'utrans_eqcct': 'UTRANS',
            'phasenet': 'PhaseNet',
            'eqtransformer': 'EQTransformer',
        }.get(getattr(self, 'architecture', 'eqcct'), 'EQCCT')
        pick.setMethodID(method_id)
        pick.setEvaluationMode(1)
        pick.setCreationInfo(ci)

        filterAndProp = "  ".join([f"Probability_{propValue}", f"Filter: {filterID}"])
        pick.setFilterID(filterAndProp)

        logging.debug("Pick produced by %s %s.%s" % (method_id, pick.waveformID().networkCode(), pick.waveformID().stationCode()))
        logging.debug('%s' % pick)

        if self.playback:
            pass
        else:
            if self.standard:
                self.sendPick(pick, 'asap')
                self.sendComt(comm, pick)

                # pickRef = PickReference()
                if phaseHint == 'S':
                    # pickRef.setPickID(pickData['PpickID'])
                    comt = Comment()
                    comt.setId('RefPickID')
                    comt.setText(str(pickData['PpickID']))
                    ci = CreationInfo()
                    ci.setCreationTime(Time().GMT())
                    comt.setCreationInfo(ci)
                    # print(pick.comment(0).id())
                    # print(pick.comment(0).text())
                    pick.add(comt)
                    self.sendComt(comt, pick)
                else:
                    # pickRef.setPickID(pick.publicID())
                    pass
            else:
                pass
        return pick.publicID(), pick

    def writeXMLObj(self, obj):
        if self._outputFile is not None:
            ar = seiscomp.io.XMLArchive()
            if not ar.create(self._outputFile):
                logging.error(
                    f"Failed to created output file: {self._outputFile}",
                    file=sys.stderr,
                )
                return False

            ar.setFormattedOutput(True)
            ar.writeObject(obj)
            ar.close()

    def sendComt(self, comt, pick):
        op = OP_ADD
        if comt:
            n = Notifier(pick.publicID(), op, comt)
            msg = NotifierMessage()
            msg.attach(n)
            out = self.connection().send(msg)
            logging.debug("Comment sent? %s" % "Yes" if out else "No, failed" )

    def sendPick(self, pick, mode='asap'):
        op = OP_ADD
        if pick:
            pickObj = Pick.Cast(pick)
            Notifier.Enable()
            # ep = EventParameters()
            # ep.add(pickObj)
            netSta_pick = f"{pickObj.waveformID().networkCode()}.{pickObj.waveformID().stationCode()}"
            if mode == 'simul':
                profile_to_target = {p["name"]: p.get("pickSimulTargetGroup") for p in self.profiles}
            elif mode == 'asap':
                profile_to_target = {p["name"]: p.get("pickTargetGroup") for p in self.profiles}
            elif mode == 'bulk':
                profile_to_target = {p["name"]: p.get("pickBulkTargetGroup") for p in self.profiles}

            logging.debug(f"Profile_to_target {profile_to_target}")
            targets = set()
            matched = False
            for b in self.bindings:
                b_net = b.get("net")
                b_sta = b.get("sta")
                if not b_net or not b_sta:
                    continue
                b_netsta = f"{b_net}.{b_sta}"
                if b_netsta != netSta_pick:
                    continue

                matched = True
                raw_profiles = b.get("profiles", "")
                prof_list = [p for p in re.split(r"[,\s]+", raw_profiles) if p]

                if not prof_list:
                    targets.add(None)
                    continue

                for prof in prof_list:
                    tgt = profile_to_target.get(prof)
                    if tgt:
                        targets.add(tgt)

            if not matched or not targets:
                targets = {None}

            n = Notifier("EventParameters", op, pickObj)
            msg = NotifierMessage()
            msg.attach(n)

            for target in targets:
                if target:
                    logging.debug(f"Trying to send pick {netSta_pick} to {target}")
                    out = self.connection().send(target, msg)
                else:
                    logging.debug(f"Trying to send pick {netSta_pick} to default target")
                    out = self.connection().send(msg)
                logging.debug("Pick sent? {}".format("Yes" if out else "No, failed"))

    def changeOrigStatus(self, origin, EvalStat):
        try:
            origin.setEvaluationStatus(EvalStat)
            logging.debug("Changing origin %s evaluation status %s" % (origin.publicID(),EvalStat))
        except Exception as e:
            logging.error("Error changing origin evaluation status {} with error {}".format(origin.publicID(),e))
        return origin

    def qualityCheckOrigin(self, origin):

        latUnc = origin.latitude().uncertainty()
        lonUnc = origin.longitude().uncertainty()
        try:
            depthUnc = origin.depth().uncertainty()
        except ValueError:
            depthUnc = 0
        depth = origin.depth().value()
        azGap = origin.quality().azimuthalGap()

        thresholds = {'latUnc': self.latUncTHR, 'lonUnc': self.lonUncTHR, 'depthUnc': self.depthUncTHR, 'depth': self.depthTHR, 'azGap': self.azGapTHR}
        values = {'latUnc': latUnc, 'lonUnc': lonUnc, 'depthUnc': depthUnc, 'depth': depth, 'azGap': azGap}

        exceeding = {key: value for key, value in values.items() if value > thresholds[key]}

        if exceeding:
            logging.debug(f"Values exceeding thresholds: {exceeding}")
            return False
        else:
            logging.debug(f"Origin fulfills thresholds: {exceeding}")
            return True

    def geographicCheckOrigin(self, region, origin):
        if isinstance(region, str):
            if region.split('.')[-1] == 'bna':
                try:
                    within = self.inPolygon(region, origin.latitude().value(), origin.longitude().value())
                    return within
                except FileNotFoundError:
                    logging.error(f'\n\n\t {region} file not found\n\n')
                    return False
            elif len(region.split(',')) == 4:
                quadrant = region.split(',')
                quadrant = tuple(map(float, quadrant))
                return self.inQuadrant(quadrant, origin)
            else:
                logging.error(f'Provide a quadrant or bna file')
                return False
        elif isinstance(region, tuple):
            return self.inQuadrant(quadrant, origin)
        else:
            logging.error(f'Provide a quadrant or bna file')
            return False

    def inPolygon(self, fileName, lat, lon) -> bool:
        self.fs = geo.GeoFeatureSet()
        if not self.fs.readBNAFile(fileName, None):
            logging.error('Impossible to open the bna file %s'%fileName)
            return False

        feature = self.fs.features()[0]
        closed = feature.closedPolygon()
        if not closed:
            logging.error('Please fix this: Polygon %s does not not exist or is not closed'%fileName)

        coordinates = geo.GeoCoordinate(lat,lon)
        within = feature.contains(coordinates)
        if not within:
            logging.debug('Origin (lat: %s and lon: %s) is not within polygon %s.' % (lat,lon,fileName))

        return(within)

    def inQuadrant(self, quadrant: tuple, origin) -> bool:
        """Check if event location is in a quadrant

        Parameters
        ----------
        quadrant : Tuple
            Quadrant to check in format (lat_min, lat_max, lon_min,  lon_max)

        Returns
        -------
        bool
            True if event is in quadrant, False if not
        """
        assert len(quadrant) == 4, 'Quadrant must be a tuple with 4 elements'
        assert quadrant[0] < quadrant[1], 'The minimum latitude must be less than the maximum latitude'
        assert quadrant[2] < quadrant[3], 'The minimum longitude must be less than the maximum longitude'
        return (quadrant[0] <= origin.latitude().value() <= quadrant[1]
                and quadrant[2] <= origin.longitude().value() <= quadrant[3])

    def handleOrigin(self, org, op=OP_UPDATE):
        """
        Test origins
        """
        logging.debug("Received origin %s" % org.publicID())
        author = org.creationInfo().author()
        profNames = (list(map(lambda p: p['name'], self.profiles)))
        logging.debug("PROFILES %s" % profNames)
        for profile in self.profiles:
            if author == profile["authorTarget"]:
                try:
                    polygon = profile["region"]
                    if polygon != 'none':
                        checkReg = self.geographicCheckOrigin(polygon, org)
                    else:
                        checkReg = True
                    checkQc = self.qualityCheckOrigin(org)
                except Exception as e:
                    logging.error(str(e))
                    logging.error("Error when performing quality checks for the origin %s" % org.publicID())
                    return
                if checkQc and checkReg:
                    org = self.changeOrigStatus(org,self.TrueOrgEvalStat)
                    locTarget = profile["locTargetGroup"]
                    if org and locTarget:
                        msg = NotifierMessage()
                        n = Notifier("EventParameters", op, org)
                        msg.attach(n)
                        out = self.connection().send(locTarget,msg)
                        logging.debug("Evaluation status updated? %s" % "Yes" if out else "No, failed" )
                # else:
                    # org = self.changeOrigStatus(org,self.FalseOrgEvalStat)
            else:
                logging.debug("Author %s not in scmlpick profile %s" %(author,profile["name"]))

    def addObject(self, parentID, object):
        """
        Call-back function if a new object is received.
        """
        origin = Origin.Cast(object)
        if origin:
            self.handleOrigin(origin, op=OP_UPDATE)

    def updateObject(self, parentID, object):
        """
        Call-back function if an object is updated.
        """
        origin = Origin.Cast(object)
        if origin:
            self.handleOrigin(origin, op=OP_UPDATE)

    def handleClose(self):
        if self.recordStream() is not None:
            self.recordStream().close()
        try:
            self.tasks_ids_end.set()
            self.monitorThread.join()
            logging.info(f'The main process has completed all tasks.')
            ray.shutdown()
            self._pacer_stop()
            self.stop_bulk_sender()
        except Exception:
            pass

    def handleAutoShutdown(self):
        if self.recordStream() is not None:
            self.recordStream().close()
        try:
            self.tasks_ids_end.set()
            self.monitorThread.join()
            logging.info(f'The main process has completed all tasks.')
            ray.shutdown()
            self._pacer_stop()
            self.stop_bulk_sender()
        except Exception:
            pass

    def run(self):
        if self.playback and self.mseed:
            try:
                if self.commandline().hasOption("start"):
                    start_time = self.commandline().optionString("start")
                    start_time = UTCDateTime(start_time)
                if self.commandline().hasOption("end"):
                    end_time = self.commandline().optionString("end")
                    end_time = UTCDateTime(end_time)
                stream = None
                stream_ref = ray.put(stream)
                params = self.params
                result = ray.get(self._launch_run_picker(start_time, end_time, stream_ref, params))
                # result = scmlpick.run_picker(start_time,end_time,stream_ref,params)
                self.scPhase(result)
            finally:
                if self.recordStream() is not None:
                    self.recordStream().close()
                try:
                    self.tasks_ids_end.set()
                    self.monitorThread.join()
                    logging.info(f'The main process has completed all tasks.')
                    ray.shutdown()
                    self._pacer_stop()
                    self.stop_bulk_sender()
                except Exception:
                    pass
            return True
        else:
            return StreamApplication.run(self)

def set_cpu_affinity(cores):
    """Set CPU affinity for the current process."""
    p = psutil.Process(os.getpid())
    p.cpu_affinity(cores)

def main(argv):
    app = scmlpick(len(argv), argv)
    return app()

if __name__ == '__main__':
    import sys
    # script_name = os.path.basename(sys.argv[0])
    script_name = os.path.splitext(os.path.basename(sys.argv[0]))[0]
    num_cores = os.cpu_count() - 1
    core_mappings = {
        script_name : list(range(num_cores)),
#    "scmlpick": list(range(0, 25)),
    }
    listCores = core_mappings.get(script_name, list(range(0, num_cores)))
    set_cpu_affinity(listCores)
    sys.exit(main(sys.argv))
