    def createCommandLineDescription(self):
        self.commandline().addGroup("ray")
        self.commandline().addIntOption("ray", "cpu-number", "Specify the number of CPUs available for Ray to use.")
        self.commandline().addIntOption("ray", "max-tasks", "Maximum number of tasks that are sent to the predictor at the same time")
        self.commandline().addGroup("mode")
        self.commandline().addOption("mode", "playback", "run in playback mode to disable real time functionality. This mode requires profile, start, end and waveform-source parameters")
        self.commandline().addGroup("waveform-source")
        self.commandline().addOption("waveform-source", "recordstream", "Run playback using data from the recordstream.  This mode requires start and end parameters")
        self.commandline().addStringOption("waveform-source", "mseed-files", "Run playback using data from mseed files. You can specify an individual mseed file or a directory containing multiple files. This mode requires both start and end parameters")
        self.commandline().addGroup("playback")
        self.commandline().addStringOption("playback", "profile", "Specify the name of the profile. This parameter is required to run in playback mode.")
        self.commandline().addStringOption("playback", "start", "Start datetime for querying the waveform source. Format: %Y-%m-%d %H:%M:%S. This parameter is required to run in playback mode.")
        self.commandline().addStringOption("playback", "end", "End datetime for querying the waveform source. Format: %Y-%m-%d %H:%M:%S. This parameter is required to run in playback mode.")
        self.commandline().addGroup("output")
        self.commandline().addOption("output", "database", "Send results to the seiscomp database.")
        self.commandline().addStringOption("output", "output-file", "Dump results to a XML file. This parameter is only allowed when running in playback mode. Specify the output file path")
        return True

    def validateParameters(self):
        if StreamApplication.validateParameters(self) == False:
            return False
        if self.commandline().hasOption("playback") and not (self.commandline().hasOption("mseed-files") or self.commandline().hasOption("recordstream")):
            logging.error("Need to declare waveform-source parameter")
            return False
        if self.commandline().hasOption("playback") and not self.commandline().hasOption("profile"):
            logging.error("Need to declare profile parameter")
            return False
        if self.commandline().hasOption("playback") and not self.commandline().hasOption("start"):
            logging.error("Need to declare start parameter")
            return False
        if self.commandline().hasOption("playback") and not self.commandline().hasOption("end"):
            logging.error("Need to declare end parameter")
            return False
        if self.commandline().hasOption("playback") and not self.commandline().hasOption("output-file"):
            logging.error("Need to declare output-file parameter")
            return False
        return True

